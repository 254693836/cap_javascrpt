{
  "_version": "1.65.0",
  "sap.app": {
    "id": "demo.productcatalog",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}",
    "dataSources": {
      "mainService": {
        "uri": "/catalog/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": { "technology": "UI5", "deviceTypes": { "desktop": true, "tablet": true, "phone": true } },
  "sap.ui5": {
    "dependencies": { "minUI5Version": "1.120.0", "libs": { "sap.f": {}, "sap.fe.templates": {}, "sap.m": {}, "sap.ui.core": {}, "sap.ui.fl": {}, "sap.ui.mdc": {}, "sap.uxap": {} } },
    "models": { "": { "dataSource": "mainService", "settings": { "synchronizationMode": "None", "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true } }, "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "demo.productcatalog.i18n.i18n" } } },
    "routing": {
      "config": { "routerClass": "sap.m.routing.Router", "viewType": "XML", "async": true },
      "routes": [
        { "pattern": ":?query:", "name": "ListReportProducts", "target": "ListReportProducts" },
        { "pattern": "Products({key}):?query:", "name": "ObjectPageProducts", "target": "ObjectPageProducts" }
      ],
      "targets": {
        "ListReportProducts": { "type": "Component", "id": "ListReportProducts", "name": "sap.fe.templates.ListReport", "options": { "settings": { "contextPath": "/Products", "navigation": { "Products": { "detail": { "route": "ObjectPageProducts" } } } } } },
        "ObjectPageProducts": { "type": "Component", "id": "ObjectPageProducts", "name": "sap.fe.templates.ObjectPage", "options": { "settings": { "contextPath": "/Products", "controlConfiguration": { "@com.sap.vocabularies.UI.v1.Identification": { "actions": { "checkExistence": { "text": "Check", "press": "demo.productcatalog.ext.controller.ObjectPageExt.onCheck" } } } } } } }
      }
    },
    "extends": { "extensions": { "sap.ui.controllerExtensions": { "sap.fe.templates.ObjectPage.ObjectPageController": { "controllerName": "demo.productcatalog.ext.controller.ObjectPageExt" } } } }
  }
}
